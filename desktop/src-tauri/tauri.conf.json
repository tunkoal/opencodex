{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCodex",
  "version": "2.96.1",
  "identifier": "com.opencodex.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ocx"
    ],
    "resources": {
      "resources/gui/dist": "gui/dist",
      "resources/keyring": "keyring"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "PlugIns/OpenCodexWidget.appex": "widget/OpenCodexWidget.appex"
      },
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGOTUwOTU4Mjg5ODI4NzAKUldSd0tKZ29XQW1WTDRZTEJGRFpSUU9sWm51WUdkekE2SThiSkZRa2VMTjZFNFFRblRvd2JycnkK",
      "endpoints": [
        "https://github.com/tunkoal/opencodex/releases/latest/download/latest.json"
      ]
    }
  }
}
